---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, GITHUB_CONFIG, POSTS_CONFIG, SOCIAL_LINKS, ABOUT_CONFIG } from '~/config.mjs'
import { cn, postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS = [
  { id: '01', title: 'Logs', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: 'Active' },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified' },
]

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout title="Home" description={SITE.description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <Aside
      badge={`V${SITE.version} - Astro v6`}
      title="Home"
      subtitleIcon="icon-[ph--user] size-4"
      subtitleText="Function Panel"
      description={ABOUT_CONFIG.introduce}
      footerLeftValue={SOCIAL_LINKS[0].name}
      footerLeftHref={SOCIAL_LINKS[0].url}
      footerLeftIcon={SOCIAL_LINKS[0].icon}
      footerRightValue={SOCIAL_LINKS[1].name}
      footerRightHref={SOCIAL_LINKS[1].url}
      footerRightIcon={SOCIAL_LINKS[1].icon}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div class="mb-24 fade-up mt-4">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Navigation</h2></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mt-4">
            {
              NAV_CARDS.map((card, i) => (
                <a
                  href={card.href}
                  class="group relative flex flex-col justify-between rounded-lg border border-border/40 bg-background/50 p-6 hover:bg-muted/20 hover:border-border hoverStyle transition-all duration-300 min-h-[180px] hoverStyle"
                  style={`animation-delay: ${i * 50}ms`}
                >
                  <div class="relative z-10 flex flex-col h-full">
                    <div class="flex justify-between items-start mb-auto">
                      <div class="size-10 flex items-center justify-center rounded-sm bg-muted/30 border border-border/40 group-hover:border-border/60 transition-colors">
                        <span class={cn('size-5 text-foreground/70 group-hover:text-foreground transition-colors', card.icon)} />
                      </div>
                      <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-foreground transition-colors mt-1" />
                    </div>
                    <div class="mt-4">
                      <h3 class="text-base font-semibold text-foreground mb-0.5 tracking-tight">{card.title}</h3>
                      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-1">{card.desc}</p>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <div class="mb-20 fade-up" style="animation-delay: 200ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>02</span><h2 class={SECTION_TITLE_CLASS}>Recent Logs</h2></div>
            <a
              href="/posts"
              class="flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
              ><span>View All</span><span class="icon-[ph--arrow-right]"></span></a
            >
          </div>
          <div class="mt-8">
            <List {posts} {type} {heroImageLayout} />
          </div>
        </div>

        {
          ENABLED && (
            <div class="mb-20 fade-up" style="animation-delay: 300ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <>
                    <span class={SECTION_NUM_CLASS}>03</span>
                    <h2 class={SECTION_TITLE_CLASS}>Activity</h2>
                  </>
                </div>
              </div>
              <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
            </div>
          )
        }

        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="fade-up" style="animation-delay: 400ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <>
                    <span class={SECTION_NUM_CLASS}>04</span>
                    <h2 class={SECTION_TITLE_CLASS}>Tech Stack</h2>
                  </>
                </div>
              </div>
              <div class="mt-8 [&_.skill-card]:rounded-lg [&_.skill-card]:border-border/40 [&_.skill-card]:bg-background/50 hover:[&_.skill-card]:bg-muted/20 [&_.skill-card]:shadow-xs">
                <SkillsShowcase skillsData={SKILLS_DATA} />
              </div>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
