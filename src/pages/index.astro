---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, GITHUB_CONFIG, POSTS_CONFIG, SOCIAL_LINKS, ABOUT_CONFIG } from '~/config.mjs'
import { cn, postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS = [
  { id: '01', title: 'Logs', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: 'Active' },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified' },
]

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout title="Home" description={SITE.description}>
  <div class="relative font-sans flex flex-col xl:flex-row min-h-screen">
    <aside
      class="aside-panel w-full xl:w-1/3 xl:sticky xl:top-0 xl:h-screen flex flex-col xl:border-r border-border/40 z-20 bg-background/50 backdrop-blur-sm relative overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 w-full h-96 bg-primary/5 rounded-full blur-3xl -z-10 translate-x-[-20%] translate-y-[-20%] pointer-events-none"
      >
      </div>

      <div class="flex flex-1 xl:overflow-y-auto scrollbar-hide flex-col relative z-10">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up flex justify-between items-start">
          <div class="flex items-center gap-3 select-none">
            <div class="size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
              <span class="icon-[ph--terminal-window-duotone] size-6"></span>
            </div>
            <div>
              <div class="text-sm font-bold tracking-tight">{SITE.title || 'Digital Hub'}</div>
              <div class="text-[10px] text-muted-foreground uppercase tracking-widest font-mono">System Online</div>
            </div>
          </div>
          <span
            class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-2.5 py-1 text-[10px] font-mono text-primary select-none"
          >
            v{SITE.version} / Astro
          </span>
        </div>

        <div class="flex-1 flex flex-col justify-center p-6 lg:p-8 xl:p-12 min-h-[50vh] xl:min-h-0 fade-up animation-delay-100">
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-muted/30 border border-border/50 text-xs font-medium text-muted-foreground mb-8 w-fit select-none"
          >
            <span class="relative flex size-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full size-2 bg-emerald-500"></span>
            </span>
            Building & Exploring
          </div>

          <h1 class="text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight text-foreground leading-[1.15] mb-4 select-none">
            Welcome to <br />
            <span class="text-transparent bg-clip-text bg-linear-to-r from-foreground to-foreground/50">My Workspace.</span>
          </h1>

          <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-8 font-mono">
            <span class="flex items-center gap-1.5"><span class="icon-[ph--code] size-4"></span> Developer</span>
            <span class="w-1 h-1 rounded-full bg-border"></span>
            <span class="flex items-center gap-1.5"><span class="icon-[ph--pen-nib] size-4"></span> Creator</span>
            <span class="w-1 h-1 rounded-full bg-border"></span>
            <span class="flex items-center gap-1.5"><span class="icon-[ph--map-pin] size-4"></span> Earth</span>
          </div>

          <div class="relative pl-4 border-l-2 border-primary/30 fade-up animation-delay-150">
            <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
              {SITE.description}
            </p>
          </div>
        </div>
      </div>

      <div class="shrink-0 border-t border-border/40 select-none fade-up animation-delay-200">
        <div
          class="p-4 flex items-center justify-between text-xs text-muted-foreground font-mono border-b border-border/40 px-6 lg:px-8 xl:px-12 bg-background/50"
        >
          <span>// CONNECT PORTALS</span>
          <span>{SOCIAL_LINKS.length} ACTIVE</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-px bg-border/40">
          {
            SOCIAL_LINKS.map((item) => (
              <a
                href={item.url}
                target="_blank"
                class="group flex flex-col items-center justify-center p-6 bg-background hover:bg-primary/5 transition-all duration-300"
              >
                <div class="p-2 rounded-full bg-muted/30 group-hover:bg-primary/10 group-hover:scale-110 transition-all duration-300 mb-2">
                  <span class={`${item.icon} size-5 text-muted-foreground group-hover:text-primary transition-colors`} />
                </div>
                <span class="text-[10px] font-mono font-medium text-muted-foreground group-hover:text-primary uppercase tracking-wider transition-colors">
                  {item.name || 'Link'}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </aside>

    <main class="w-full min-w-0 xl:flex-1 z-10 flex flex-col fade-up animation-delay-150">
      <div class="w-full p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col md:px-12">
        <div class="mb-24 fade-up mt-4">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Navigation</h2></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mt-4">
            {
              NAV_CARDS.map((card, i) => (
                <a
                  href={card.href}
                  class="group relative flex flex-col justify-between rounded-lg border border-border/40 bg-background/50 p-6 hover:bg-muted/20 hover:border-border hoverStyle transition-all duration-300 min-h-[180px] hoverStyle"
                  style={`animation-delay: ${i * 50}ms`}
                >
                  <div class="relative z-10 flex flex-col h-full">
                    <div class="flex justify-between items-start mb-auto">
                      <div class="size-10 flex items-center justify-center rounded-sm bg-muted/30 border border-border/40 group-hover:border-border/60 transition-colors">
                        <span class={cn('size-5 text-foreground/70 group-hover:text-foreground transition-colors', card.icon)} />
                      </div>
                      <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-foreground transition-colors mt-1" />
                    </div>
                    <div class="mt-4">
                      <h3 class="text-base font-semibold text-foreground mb-0.5 tracking-tight">{card.title}</h3>
                      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-1">{card.desc}</p>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <div class="mb-20 fade-up" style="animation-delay: 200ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>02</span><h2 class={SECTION_TITLE_CLASS}>Recent Logs</h2></div>
            <a
              href="/posts"
              class="flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
              ><span>View All</span><span class="icon-[ph--arrow-right]"></span></a
            >
          </div>
          <div class="mt-8">
            <List {posts} {type} {heroImageLayout} />
          </div>
        </div>

        {
          ENABLED && (
            <div class="mb-20 fade-up" style="animation-delay: 300ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <>
                    <span class={SECTION_NUM_CLASS}>03</span>
                    <h2 class={SECTION_TITLE_CLASS}>Activity</h2>
                  </>
                </div>
              </div>
              <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
            </div>
          )
        }

        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="fade-up" style="animation-delay: 400ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <>
                    <span class={SECTION_NUM_CLASS}>04</span>
                    <h2 class={SECTION_TITLE_CLASS}>Tech Stack</h2>
                  </>
                </div>
              </div>
              <div class="mt-8 [&_.skill-card]:rounded-lg [&_.skill-card]:border-border/40 [&_.skill-card]:bg-background/50 hover:[&_.skill-card]:bg-muted/20 [&_.skill-card]:shadow-xs">
                <SkillsShowcase skillsData={SKILLS_DATA} />
              </div>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
