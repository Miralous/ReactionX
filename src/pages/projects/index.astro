---
import { PROJECTS_CONFIG, GITHUB_CONFIG } from '~/config.mjs'
import GithubProjectGrid from '~/components/projects/GithubProjectList'
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'

const { title, description, introduce } = PROJECTS_CONFIG
const username = GITHUB_CONFIG.GITHUB_USERNAME
const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col xl:flex-row min-h-screen">
            <Aside
      badge="Online"
      badgeGreenDot={true}
      title={title}
      subtitleIcon="icon-[ph--stack] size-4"
      subtitleText="Module Registry"
      description={introduce}
      footerLeftValue="Github"
      footerLeftLabel="Host"
      footerRightValue={new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}
      footerRightLabel="Last Update"
    />

    <main class="w-full min-w-0 xl:flex-1 z-10 flex flex-col fade-up animation-delay-100 mx-auto max-w-[1200px]">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Component Sequence</h2>
          </div>
        </div>

        <GithubProjectGrid client:load {username} />
      </div>
    </main>
  </div>
</Layout>






