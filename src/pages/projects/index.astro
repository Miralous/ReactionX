---
import { cn } from '~/lib/utils'
import { PROJECTS_CONFIG, GITHUB_CONFIG } from '~/config.mjs'
import Layout from '~/layouts/Layout.astro'

const { title, description, introduce } = PROJECTS_CONFIG
const username = GITHUB_CONFIG.GITHUB_USERNAME
const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col xl:border-r border-border/40 z-20 bg-background">
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up">
          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-ctp-green/10 px-3 py-1 text-xs font-medium text-ctp-green select-none"
          >
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ctp-green opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-ctp-green"></span>
            </span>
            Online
          </span>
        </div>
        <div
          class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px] fade-up animation-delay-100"
        >
          <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-6 select-none">{title}</h1>
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <span class="icon-[ph--stack] size-4"></span><span>Module Registry</span>
          </div>
        </div>
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 fade-up animation-delay-150">
          <p class="text-sm text-muted-foreground leading-relaxed">{introduce}</p>
        </div>
      </div>
      <div class="flex border-t border-border/40 shrink-0 fade-up animation-delay-200">
        <div
          class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background border-r border-border/40 hover:bg-muted/30 transition-colors"
        >
          <span class="text-2xl font-semibold text-foreground tracking-tight" id="repo-count">--</span>
          <span class="text-xs text-muted-foreground mt-1">Total Modules</span>
        </div>
        <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background hover:bg-muted/30 transition-colors">
          <span class="text-xl font-semibold text-foreground tracking-tight"
            >{new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}</span
          >
          <span class="text-xs text-muted-foreground mt-1">Last Update</span>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-100">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Component Sequence</h2>
          </div>
        </div>

        <div id="repo-grid" class="grid grid-cols-1 gap-6 mt-8"></div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { PROJECTS_CONFIG, GITHUB_CONFIG } from '~/config'
  const username = GITHUB_CONFIG.GITHUB_USERNAME
  const CACHE_KEY = 'gh_projects_data'
  const CACHE_DURATION = 60 * 60 * 1000

  // 1. Define an interface for the GitHub API response
  interface Repository {
    name: string
    description: string | null
    html_url: string
    homepage: string | null
    archived: boolean
    language: string | null
    stargazers_count: number
    forks_count: number
  }

  // Type the return value of the cache fetcher
  function getCached(): Repository[] | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY)
      if (!raw) return null
      const { data, timestamp } = JSON.parse(raw)
      if (Date.now() - timestamp < CACHE_DURATION) return data as Repository[]
    } catch {}
    return null
  }

  // 2. Add the Repository[] type to the parameter
  function renderRepos(repos: Repository[]) {
    const grid = document.getElementById('repo-grid')
    const countEl = document.getElementById('repo-count')

    // 3. Add a null check for countEl
    if (!grid || !countEl) return

    countEl.textContent = repos.length.toString().padStart(2, '0')

    if (repos.length === 0) {
      grid.innerHTML =
        '<div class="flex flex-col items-center justify-center py-20 text-muted-foreground"><span class="icon-[ph--warning-circle] size-10 text-ctp-yellow/80 mb-3"></span><p class="text-sm">No repositories found</p></div>'
      return
    }

    grid.innerHTML = repos
      .map(
        (repo, i) => `
      <div class="group relative flex flex-col bg-background/50 border border-border/40 rounded-lg hover:bg-muted/20 hover:shadow-xs transition-all duration-300 fade-up hover:-translate-y-0.5" style="animation-delay: ${i * 100}ms">
        <div class="p-6 pb-2 relative z-10 flex justify-between items-start">
          <div class="size-12 flex items-center justify-center rounded-md bg-muted/30 border border-border/40">
            <span class="icon-[mdi--github] size-6 text-foreground/80"></span>
          </div>
          <div class="flex gap-2">
            ${repo.html_url ? `<a href="${repo.html_url}" target="_blank" class="flex items-center justify-center size-8 rounded-full bg-muted/50 hover:bg-muted text-muted-foreground hover:text-foreground transition-all"><span class="icon-[mdi--github] size-4"></span></a>` : ''}
            ${repo.homepage ? `<a href="${repo.homepage}" target="_blank" class="flex items-center justify-center size-8 rounded-full bg-muted/50 hover:bg-muted text-muted-foreground hover:text-foreground transition-all"><span class="icon-[ph--arrow-up-right] size-4"></span></a>` : ''}
          </div>
        </div>
        <div class="p-6 pt-2 flex-1 relative z-10">
          <a href="${repo.html_url}" target="_blank" class="block">
            <h3 class="text-base font-semibold text-foreground tracking-tight">${repo.name}</h3>
          </a>
          <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">${repo.description || 'No description'}</p>
        </div>
        <div class="mt-auto border-t border-border/40 px-6 py-2 bg-muted/10 rounded-b-xl flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
            <span class="size-1.5 rounded-full ${repo.archived ? 'bg-ctp-yellow' : 'bg-ctp-green'}"></span>
            ${repo.archived ? 'Archived' : 'Active'}
          </span>
          <div class="flex items-center gap-3 text-xs text-muted-foreground">
            ${repo.language ? `<span>${repo.language}</span>` : ''}
            <span class="flex items-center gap-1"><span class="icon-[ph--star] size-3"></span>${repo.stargazers_count}</span>
            <span class="flex items-center gap-1"><span class="icon-[ph--git-fork] size-3"></span>${repo.forks_count}</span>
          </div>
        </div>
      </div>
    `
      )
      .join('')

    const sb = document.querySelector('.scrollbar-hide')
    if (sb) sb.scrollTop = 0
  }

  async function fetchRepos() {
    try {
      // 4. Type the headers object so TS allows dynamic key assignment
      const headers: Record<string, string> = {}
      const token = import.meta.env.PUBLIC_GITHUB_TOKEN
      if (token) headers['Authorization'] = `Bearer ${token}`

      const res = await fetch(`https://api.github.com/users/${username}/repos?per_page=100&sort=pushed&type=owner`, { headers })

      if (!res.ok) throw new Error(`GitHub API ${res.status}`)

      // 5. Explicitly type the JSON payload from GitHub
      const all: Repository[] = await res.json()
      const repos = all.filter((r) => r.name !== '.github' && r.name.toLowerCase() !== username.toLowerCase())

      localStorage.setItem(CACHE_KEY, JSON.stringify({ data: repos, timestamp: Date.now() }))
      renderRepos(repos)
    } catch {}
  }

  const cached = getCached()
  if (cached) {
    renderRepos(cached)
  }
  fetchRepos()
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
