---
import { getCollection } from 'astro:content'
import { FRIENDS_CONFIG, FRIENDS_CONTACT, FRIENDS_DIRECTORIES } from '~/config.mjs'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'

const friendsEntries = await getCollection('friends')
const FRIENDS_LIST = friendsEntries.map((e) => ({ id: e.id, ...e.data }))
const { title, description, introduce, enableAdd } = FRIENDS_CONFIG
const { sitename, email, author, sitelink, siteavatar, description: myDescription } = FRIENDS_CONTACT
const totalLinks = FRIENDS_LIST.length.toString().padStart(2, '0')

// Group friends by directory
const grouped: Record<string, typeof FRIENDS_LIST> = {}
for (const friend of FRIENDS_LIST) {
  const dir = friend.directory || ''
  if (!grouped[dir]) grouped[dir] = []
  grouped[dir].push(friend)
}

interface SectionConfig {
  key: string
  label: string
  num?: string
}

interface Section extends SectionConfig {
  friends: typeof FRIENDS_LIST
  num: string
}

const sections: Section[] = FRIENDS_DIRECTORIES.map((cfg, i) => ({
  ...cfg,
  friends: (grouped[cfg.key] || []).sort((a, b) => (b.weight || 0) - (a.weight || 0)),
  num: cfg.num || String(i + 1).padStart(2, '0'),
}))
  .filter((s) => s.friends.length > 0)
  .sort((a, b) => parseInt(a.num) - parseInt(b.num))

const allNums = sections.map((s) => parseInt(s.num))
const exchangeSectionNum = allNums.length ? Math.max(...allNums) + 1 : 1

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-3 mb-6 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/50 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'

function renderFriendCard(f: (typeof FRIENDS_LIST)[0]) {
  return `<a href="${f.url}" target="_blank" rel="noopener noreferrer" class="friend-card group flex flex-col justify-between rounded-lg border border-border/40 bg-background/50 p-5 hover:bg-muted/20 hover:border-border hoverStyle transition-all duration-300 min-h-[160px] hoverStyle">
    <div class="friend-content flex flex-col h-full w-full">
      <div class="flex items-start justify-between mb-3">
        <img src="${f.avatar || defaultImg}" alt="${f.name}" class="size-10 rounded-full object-cover ring-1 ring-border/50 bg-muted/30" loading="lazy" />
        <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-foreground transition-colors mt-1"></span>
      </div>
      <div class="flex flex-col flex-1">
        <h3 class="font-semibold text-base text-foreground tracking-tight line-clamp-1">${f.name}</h3>
        <div class="text-xs font-medium text-muted-foreground line-clamp-1 mt-0.5 mb-3">${f.author}</div>
        <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2 mt-auto">${f.description || 'No description provided.'}</p>
      </div>
    </div>
  </a>`
}

function renderSection(section: (typeof sections)[0]) {
  const header = `<div class="${SECTION_HEADER_CLASS}"><div class="flex items-center"><span class="${SECTION_NUM_CLASS}">${section.num}</span><h2 class="${SECTION_TITLE_CLASS}">${section.label}</h2></div></div>`
  const cards = section.friends.map(renderFriendCard).join('')
  return `<div class="mb-24">${header}<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6 mt-4 fade-up animation-delay-200">${cards}</div></div>`
}

const sectionsHtml = sections.map(renderSection).join('')

const defaultImg = 'https://pic2.zhimg.com/50/v2-cc1a32fcb444fc9d5e23f2ee078dc6e1_720w.jpg?source=1940ef5c'
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col xl:border-r border-border/40 z-20 bg-background">
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up">
          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-ctp-green/10 px-3 py-1 text-xs font-medium text-ctp-green select-none"
          >
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ctp-green opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-ctp-green"></span>
            </span>
            Connected
          </span>
        </div>

        <div
          class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px] fade-up animation-delay-100"
        >
          <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-4 select-none">{title}</h1>
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <span class="icon-[ph--planet] size-4"></span>
            <span>Network & Signals</span>
          </div>
        </div>

        <div class="shrink-0 p-6 lg:p-8 xl:p-12 fade-up animation-delay-150">
          <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">{introduce}</p>
        </div>
      </div>

      <div class="flex border-t border-border/40 shrink-0 fade-up animation-delay-200">
        <div
          class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background border-r border-border/40 hover:bg-muted/30 transition-colors"
        >
          <span class="text-2xl font-semibold text-foreground tracking-tight">{totalLinks}</span>
          <span class="text-xs text-muted-foreground mt-1">Active Nodes</span>
        </div>
        <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background hover:bg-muted/30 transition-colors">
          <span class="text-xl font-semibold text-foreground tracking-tight">HTTPS</span>
          <span class="text-xs text-muted-foreground mt-1">Protocol</span>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div set:html={sectionsHtml} />

        {
          enableAdd ? (
            <>
              <div id="exchange-section" class="fade-up animation-delay-200">
                <div class={SECTION_HEADER_CLASS}>
                  <div class="flex items-center">
                    <>
                      <span class={SECTION_NUM_CLASS}>{String(exchangeSectionNum).padStart(2, '0')}</span>{' '}
                      <h2 class={SECTION_TITLE_CLASS}>Exchange Protocol</h2>
                    </>
                  </div>
                </div>
                <div class="grid xl:grid-cols-2 gap-10 mt-6">
                  {/* 规则与联系方式 */}
                  <div class="flex flex-col">
                    <div>
                      <h3 class="text-lg font-semibold tracking-tight mb-4 text-foreground">Requirements</h3>
                      <ul class="space-y-3 text-sm text-muted-foreground">
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>Content must comply with industry standards and contain no NSFW material.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>Before applying, please add this site to your link list.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>Priority given to tech, design, and indie blogs.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--warning-circle-fill] size-4 text-ctp-yellow shrink-0 mt-0.5" />
                          <span>Inactive nodes will be periodically cleaned.</span>
                        </li>
                      </ul>
                    </div>

                    <div class="mt-8 p-5 rounded-lg border border-border/40 bg-muted/10">
                      <span class="text-xs font-semibold text-foreground block mb-2">Direct Contact</span>
                      <a
                        href={`mailto:${email}`}
                        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
                      >
                        <span class="icon-[ph--envelope-simple] size-4 group-hover:text-primary transition-colors" />
                        <span class="font-medium">{email}</span>
                      </a>
                    </div>
                  </div>

                  {/* 右侧：站点配置信息 */}
                  <div class="relative">
                    <div class="rounded-lg border border-border/40 bg-background overflow-hidden flex flex-col h-full">
                      <div class="px-5 py-4 border-b border-border/40 bg-muted/20 flex justify-between items-center">
                        <span class="font-semibold text-sm tracking-tight">Site Configuration</span>
                        <span class="text-xs font-medium text-muted-foreground bg-background border border-border/40 px-2 py-0.5 rounded-md">
                          JSON
                        </span>
                      </div>

                      <div class="p-5 space-y-3 flex-1">
                        {[
                          { label: 'Name', value: sitename },
                          { label: 'Author', value: author },
                          { label: 'URL', value: sitelink },
                          { label: 'Avatar', value: siteavatar },
                          { label: 'Description', value: myDescription },
                        ].map((item) => (
                          <div class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4 p-2 rounded-lg hover:bg-muted/30 transition-colors">
                            <span class="text-muted-foreground text-xs font-medium w-20 shrink-0 pt-0.5 select-none">{item.label}</span>
                            <span class="text-foreground text-sm font-mono break-all select-all">{item.value}</span>
                          </div>
                        ))}
                      </div>

                      <div class="p-5 pt-0 mt-auto">
                        <button
                          id="copy-btn"
                          class="copy-trigger w-full py-2.5 bg-foreground text-background hover:bg-foreground/90 transition-all rounded-md text-sm font-semibold flex items-center justify-center gap-2"
                          data-sitename={sitename}
                          data-author={author}
                          data-sitelink={sitelink}
                          data-siteavatar={siteavatar}
                          data-description={myDescription}
                        >
                          <span id="copy-icon" class="icon-[ph--copy] size-4" />
                          <span id="copy-text">Copy Configuration</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pb-12 mt-20 w-full fade-up">
                <Comments />
              </div>
            </>
          ) : (
            <div class="mt-24 pb-12 w-full fade-up">
              <div class="rounded-lg border border-border/40 bg-muted/10 p-12 text-center flex flex-col items-center justify-center min-h-[250px]">
                <span class="icon-[ph--link-break] size-10 text-muted-foreground/40 mb-4 block mx-auto" />
                <p class="text-foreground font-medium mb-2">System Disabled</p>
                <p class="text-muted-foreground text-sm">Link request channel is offline. Contact the owner via email if needed.</p>
              </div>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  function initCopy() {
    const btns = document.querySelectorAll('.copy-trigger')
    btns.forEach((btn) => {
      const newBtn = btn.cloneNode(true)
      btn.parentNode.replaceChild(newBtn, btn)

      newBtn.addEventListener('click', () => {
        const icon = newBtn.querySelector('#copy-icon')
        const text = newBtn.querySelector('#copy-text')

        const myInfo = {
          name: newBtn.dataset.sitename,
          author: newBtn.dataset.author,
          url: newBtn.dataset.sitelink,
          avatar: newBtn.dataset.siteavatar,
          description: newBtn.dataset.description,
        }

        navigator.clipboard
          .writeText(JSON.stringify(myInfo, null, 2))
          .then(() => {
            if (icon) icon.className = 'icon-[ph--check-circle-fill] size-4'
            if (text) text.textContent = 'Copied!'

            newBtn.classList.remove('bg-foreground', 'text-background')
            newBtn.classList.add('bg-emerald-500', 'text-background')

            setTimeout(() => {
              if (icon) icon.className = 'icon-[ph--copy] size-4'
              if (text) text.textContent = 'Copy Configuration'
              newBtn.classList.add('bg-foreground', 'text-background')
              newBtn.classList.remove('bg-emerald-500', 'text-white')
            }, 2000)
          })
          .catch(console.error)
      })
    })
  }

  function initAll() {
    initCopy()
  }

  document.addEventListener('astro:page-load', initAll)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll)
  } else {
    initAll()
  }
</script>
