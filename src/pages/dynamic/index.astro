---
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'
import DynamicFeed from '~/components/dynamic/DynamicFeed'
import { DYNAMIC_CONFIG } from '~/config.mjs'
import { getCollection } from 'astro:content'

const dynamicEntries = await getCollection('dynamic')
const dynamicData = dynamicEntries
  .map((e) => ({ id: e.data.id, content: e.body ?? '', date: e.data.date, mood: e.data.mood, link: e.data.link }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
const feed = dynamicData as Array<{ id: string; content: string; date: string; mood: string; link: string | null }>

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout title={DYNAMIC_CONFIG.title} description={DYNAMIC_CONFIG.introduce}>
  <div class="relative font-sans flex flex-col xl:flex-row min-h-screen">
            <Aside
      statusText="Live Sync"
      statusHasPing={true}
      title={DYNAMIC_CONFIG.title}
      subtitleIcon="icon-[ph--activity] size-4"
      subtitleText="Signal Stream"
      intro={DYNAMIC_CONFIG.introduce}
      stats={[
        { value: 'API', label: 'Data Source' },
        { value: '30m', label: 'Edge Cache' },
      ]}
    />

    <main class="w-full min-w-0 xl:flex-1 z-10 flex flex-col fade-up animation-delay-100">
      <div class="w-full p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 md:px-12">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span>
            <h2 class={SECTION_TITLE_CLASS}>Timeline</h2>
          </div>
        </div>

        <DynamicFeed items={feed} />
      </div>
    </main>
  </div>

  <script>
    function initDynamicFeed() {
      document.querySelectorAll<HTMLElement>('[data-dynamic-feed]').forEach((feed) => {
        const perPage = Number(feed.dataset.itemsPerPage || 8)
        const cards = Array.from(feed.querySelectorAll<HTMLElement>('[data-dynamic-card]'))
        const loadMore = feed.querySelector<HTMLElement>('[data-dynamic-load-more]')
        const loadMoreWrap = loadMore?.parentElement
        const end = feed.querySelector<HTMLElement>('[data-dynamic-end]')
        let visibleCount = cards.filter((card) => !card.classList.contains('hidden')).length || perPage

        const updateVisibleCards = () => {
          cards.forEach((card, index) => {
            card.classList.toggle('hidden', index >= visibleCount)
          })
          const hasMore = visibleCount < cards.length
          loadMoreWrap?.classList.toggle('hidden', !hasMore)
          end?.classList.toggle('hidden', hasMore)
          end?.classList.toggle('flex', !hasMore)
        }

        cards.forEach((card) => {
          const collapse = card.querySelector<HTMLElement>('[data-dynamic-collapse]')
          const content = card.querySelector<HTMLElement>('[data-dynamic-content]')
          const toggle = card.querySelector<HTMLButtonElement>('[data-dynamic-toggle]')
          const text = card.querySelector<HTMLElement>('[data-dynamic-toggle-text]')
          const icon = card.querySelector<HTMLElement>('[data-dynamic-toggle-icon]')
          const fade = card.querySelector<HTMLElement>('[data-dynamic-fade]')
          if (!collapse || !content || !toggle || !text || !icon || !fade) return

          const syncOverflow = () => {
            const hasOverflow = content.scrollHeight > 160
            toggle.classList.toggle('hidden', !hasOverflow)
            toggle.classList.toggle('inline-flex', hasOverflow)
            fade.classList.toggle('hidden', !hasOverflow || toggle.getAttribute('aria-expanded') === 'true')
          }

          toggle.onclick = () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true'
            toggle.setAttribute('aria-expanded', String(!expanded))
            collapse.classList.toggle('max-h-[160px]', expanded)
            collapse.classList.toggle('max-h-[3000px]', !expanded)
            text.textContent = expanded ? 'Read more' : 'Show less'
            icon.className = expanded ? 'icon-[ph--caret-down-bold] size-3.5' : 'icon-[ph--caret-up-bold] size-3.5'
            fade.classList.toggle('hidden', !expanded)
          }

          syncOverflow()
          new ResizeObserver(syncOverflow).observe(content)
        })

        loadMore?.addEventListener('click', () => {
          visibleCount += perPage
          updateVisibleCards()
        })
        updateVisibleCards()
      })
    }

    initDynamicFeed()
    document.addEventListener('astro:after-swap', initDynamicFeed)
  </script>
</Layout>



