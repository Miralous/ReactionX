---
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'
import DynamicFeed from '~/components/dynamic/DynamicFeed'
import { DYNAMIC_CONFIG } from '~/config.mjs'
import { getCollection } from 'astro:content'

const dynamicEntries = await getCollection('dynamic')
const dynamicData = dynamicEntries.map((e) => e.data).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
const feed = dynamicData as Array<{ id: string; content: string; date: string; mood: string; link: string | null }>

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout title={DYNAMIC_CONFIG.title} description={DYNAMIC_CONFIG.introduce}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
            <Aside
      badge="Live Sync"
      badgeGreenDot={true}
      title={DYNAMIC_CONFIG.title}
      subtitleIcon="icon-[ph--activity] size-4"
      subtitleText="Signal Stream"
      description={DYNAMIC_CONFIG.introduce}
      footerLeftValue="API"
      footerLeftLabel="Data Source"
      footerRightValue="30m"
      footerRightLabel="Edge Cache"
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-100">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span>
            <h2 class={SECTION_TITLE_CLASS}>Timeline</h2>
          </div>
        </div>

        <DynamicFeed client:load items={feed} />
      </div>
    </main>
  </div>
</Layout>



