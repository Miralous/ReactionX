---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config.mjs'
import { postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import Aside from '~/components/base/Aside.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)
  return paginate(sortedPosts, { pageSize: POSTS_CONFIG.postPageConfig.size })
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
}
const { page } = Astro.props
const { title, description, introduce } = POSTS_CONFIG
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100)

const SECTION_HEADER_CLASS = 'flex items-center justify-between border-b border-border/40 pb-4 mb-4 select-none'
const SECTION_TITLE_CLASS = 'text-lg font-semibold tracking-tight text-foreground'
const SECTION_NUM_CLASS =
  'inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3'
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
            <Aside
      badge="Feed Live"
      title={title}
      subtitleIcon="icon-[ph--book-open] size-4"
      subtitleText="Directory Listing"
      description={introduce}
      footerLeftValue={String(page.total)}
      footerLeftLabel="Total Entries"
      footerRightValue={`${page.currentPage} / ${page.lastPage}`}
      footerRightLabel="Page"
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-100">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Stream Sequence</h2></div>
        </div>

        <div class="relative z-10 flex-1 min-h-[400px] mt-4 fade-up animation-delay-200">
          <List posts={page.data} type={POSTS_CONFIG.postPageConfig.type} heroImageLayout={POSTS_CONFIG.postPageConfig?.heroImageLayout} />
        </div>

        <div class="mt-20 pt-8 border-t border-border/40">
          <div class="mb-8">
            <div class="flex justify-between text-xs text-muted-foreground mb-3">
              <span>Reading Progress</span><span>{progressPercent}%</span>
            </div>
            <div class="w-full h-1.5 bg-muted/50 rounded-full overflow-hidden">
              <div class="h-full bg-primary transition-all duration-700 ease-out rounded-full" style={`width: ${progressPercent}%`}></div>
            </div>
          </div>
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="hidden md:flex flex-col gap-1">
              <span class="text-sm font-medium text-foreground">Navigation</span>
              <span class="text-xs text-muted-foreground">Select a page to continue reading.</span>
            </div>
            <div class="flex-1 w-full md:w-auto flex justify-center md:justify-end"><Pagination {page} baseUrl="/posts" /></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>



